# ===========================================================================
# Content Creator Engine - Environment Configuration
# Copy to .env and fill in. The app runs WITHOUT any keys (mock providers),
# but real keys unlock live AI generation and web research.
# ===========================================================================

# --- AI provider (modular). Options: anthropic | mock ---
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Default model used for generation/scoring/revision
ANTHROPIC_MODEL=claude-opus-4-8

# --- Research provider. Options: anthropic_web | mock ---
RESEARCH_PROVIDER=anthropic_web

# --- Database. Default: local SQLite. For Postgres/Supabase, set a URL like:
#     postgresql+psycopg://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=sqlite:///./data/content_engine.db

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-in-production
# Single-user dev mode auto-provisions this user. Set to 0 to require auth header.
SINGLE_USER_MODE=1
DEFAULT_USER_EMAIL=owner@local
