# Sports Card Tracker configuration
# Copy to .env and fill in.

# Enables Claude Vision auto-fill from card photos. Without it, the app still
# works as a manual tracker (you type the card details yourself).
ANTHROPIC_API_KEY=

# Optional: override the vision model (defaults to claude-opus-4-8).
# Use claude-sonnet-4-6 for lower cost on high volume.
CARD_VISION_MODEL=
