# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
env/
.venv/

# Secrets — NEVER commit
.env
.env.local
*.pem
*.key

# Runtime data — user-specific, don't commit
data/pipeline.db
data/pipeline.db-journal
data/pipeline.db-wal
data/pipeline.db-shm
data/backups/
data/logs/

# macOS
.DS_Store

# Editor
.vscode/
.idea/
*.swp
*.swo

# Node (if ever added)
node_modules/

# Large source PDFs — keep the CSV/markdown, ignore the PDF
*.pdf

# Temp imports from this session
/tmp/hs_*

# Alembic — keep versions, but not local test runs
# (versions ARE committed for migration history)
